-- ==========================================
-- 1. ระบบความปลอดภัยหลบเลี่ยงแอนตี้ชีท (ANTI-CHEAT BYPASS)
-- ==========================================
-- ดักจับการดึงค่าข้อมูลความเร็วผ่าน Metatable เพื่อส่งค่าหลอก (0, 0, 0) ป้องกันระบบเซิร์ฟเวอร์ตรวจจับได้
local gameMetatable = getrawmetatable(game)
local oldIndex = gameMetatable.__index
setreadonly(gameMetatable, false)

gameMetatable.__index = newcclosure(function(self, key)
    if not checkcaller() then
        -- เมื่อแอนตี้ชีทดึงค่าความเร็วของวัตถุฟิสิกส์ สคริปต์จะปลอมแปลงค่าทันที (Spoofing)
        if (key == "Velocity" or key == "AssemblyLinearVelocity") and self:IsA("BasePart") then
            return Vector3.new(0, 0, 0)
        end
    end
    return oldIndex(self, key)
end)

setreadonly(gameMetatable, true)

-- ==========================================
-- 2. ระบบเคลียร์หน่วยความจำลดอาการเกมกระตุก (LAG REDUCTION)
-- ==========================================
-- ประยุกต์ใช้เธรดขนานคู่ขนานในการรันสคริปต์และ pcall เพื่อลดการใช้แรมบนโทรศัพท์มือถือ
task.spawn(function()
    while task.wait(15) do
        pcall(function() -- ป้องกันเธรดหยุดทำงานเมื่อวัตถุถูกลบกะทันหัน
            -- วนลูปเคลียร์เศษซากขยะในเกมเพื่อคืนค่าแรมส่วนเกิน
            for _, child in ipairs(workspace:GetChildren()) do
                if child:IsA("Debris") or child:IsA("Explosion") then
                    child:Destroy()
                end
            end
            collectgarbage("collect") -- บังคับระบบเก็บกวาดขยะของ Luau ให้รันบนมือถือลื่นๆ
        end)
    end
end)

-- ==========================================
-- 3. ฟังก์ชันควบคุมฟิสิกส์ปรับความเร็วรถยนต์
-- ==========================================
-- ฟังก์ชันตรวจสอบและดึงเบาะนั่งคนขับรถยนต์ที่ใช้งานอยู่
local function getPlayerVehicle()
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            return humanoid.SeatPart
        end
    end
    return nil
end

-- ปรับแต่งการประมวลผลความเร็วด้วยลูปความถี่สูง Heartbeat 
RunService.Heartbeat:Connect(function()
    if SpeedHackEnabled then
        pcall(function() -- ใช้ pcall ครอบระบบหลักป้องกันสคริปต์พังเวลาลงจากรถยนต์
            local vehicleSeat = getPlayerVehicle()
            if vehicleSeat then
                -- สุ่มค่าผันผวนความเร็วเล็กน้อย +/- 1.5% เลียนแบบการขับรถปกติของมนุษย์ (Human-like behavior)
                local noise = math.random(-15, 15) / 1000
                local dynamicSpeed = TargetVehicleSpeed * (1 + noise)
                
                -- สุ่มค่าเบี่ยงเบนพิกัดเยื้อง (Random Offset 1-3 studs) บนแกนฟิสิกส์เลี่ยงการตรวจจับ
                local randomOffset = Vector3.new(
                    math.random(-15, 15) / 10,
                    0,
                    math.random(-15, 15) / 10
                )
                
                -- เร่งความเร็วก็ต่อเมื่อมีการเคลื่อนไหวของรถยนต์จริงๆ
                if vehicleSeat.AssemblyLinearVelocity.Magnitude > 2 then
                    local moveDirection = vehicleSeat.CFrame.LookVector
                    vehicleSeat.AssemblyLinearVelocity = (moveDirection * dynamicSpeed) + randomOffset
                end
            end
        end)
    end
end)

